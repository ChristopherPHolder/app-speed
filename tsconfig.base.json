{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@app-speed/aws-deploy": ["tools/aws-deploy/src/index.ts"],
      "@app-speed/db-tools": ["tools/db-tools/src/index.ts"],
      "@app-speed/effect-tools": ["tools/effect-tools/src/index.ts"],
      "@app-speed/test-orchestration": ["tools/test-orchestration/src/index.ts"],
      "@app-speed/audit/user-flow/feature-builder": ["libs/audit/user-flow/feature-builder/src/index.ts"],
      "@app-speed/audit/user-flow/feature-viewer": ["libs/audit/user-flow/feature-viewer/src/index.ts"],
      "@app-speed/audit/core/feature-history": ["libs/audit/core/feature-history/src/index.ts"],
      "@app-speed/ui": ["libs/ui/src/public-api.ts"],
      "@app-speed/ui/scroll-container": ["libs/ui/scroll-container/public-api.ts"],
      "@app-speed/ui/status-badge": ["libs/ui/status-badge/public-api.ts"],
      "@app-speed/audit/core/runner": ["libs/audit/core/runner/src/public-api.ts"],
      "@app-speed/audit/user-flow/runner": ["libs/audit/user-flow/runner/src/index.ts"],
      "@app-speed/audit/core/api-runtime": ["libs/audit/core/api-runtime/src/index.ts"],
      "@app-speed/audit/user-flow/api-runtime": ["libs/audit/user-flow/api-runtime/src/index.ts"],
      "@app-speed/platform/observability": ["libs/platform/observability/src/public-api.ts"],
      "@app-speed/audit/core/api-contract": ["libs/audit/core/api-contract/src/index.ts"],
      "@app-speed/audit/user-flow/api-contract": ["libs/audit/user-flow/api-contract/src/index.ts"],
      "@app-speed/audit/core/persistence": ["libs/audit/core/persistence/src/index.ts"],
      "@app-speed/audit/user-flow/persistence": ["libs/audit/user-flow/persistence/src/index.ts"],
      "@app-speed/audit/core/portal-ui": ["libs/audit/core/portal-ui/src/index.ts"],
      "@app-speed/audit/core/portal-ui/icons": ["libs/audit/core/portal-ui/icons/src/index.ts"],
      "@app-speed/audit/core/portal-ui/dialogs": ["libs/audit/core/portal-ui/dialogs/src/index.ts"],
      "@app-speed/audit/core/portal-ui/form-fields": ["libs/audit/core/portal-ui/form-fields/src/index.ts"],
      "@app-speed/audit/user-flow/portal-data-access": ["libs/audit/user-flow/portal-data-access/src/index.ts"],
      "@app-speed/audit/core/domain": ["libs/audit/core/domain/src/index.ts"],
      "@app-speed/audit/user-flow/domain": ["libs/audit/user-flow/domain/src/index.ts"],
      "@app-speed/convenience/feature-catalog": ["libs/convenience/feature-catalog/src/index.ts"],
      "@app-speed/convenience/trace/domain": ["libs/convenience/trace/domain/src/index.ts"],
      "@app-speed/convenience/trace/portal-data-access": ["libs/convenience/trace/portal-data-access/src/index.ts"],
      "@app-speed/convenience/trace/portal-ui": ["libs/convenience/trace/portal-ui/src/index.ts"],
      "@app-speed/convenience/trace/feature-tools": ["libs/convenience/trace/feature-tools/src/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  }
}
