{
  "name": "audit-user-flow-api-runtime",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audit/user-flow/api-runtime/src",
  "projectType": "library",
  "tags": ["type:domain", "scope:audit", "feature:audit-user-flow", "runtime:node", "layer:application"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/{projectRoot}",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "format": ["esm"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "effect:diagnostics": {
      "executor": "@app-speed/effect-tools:diagnostics",
      "options": {
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "format": "text",
        "severity": "error,warning,message"
      }
    }
  }
}
