{
  "name": "audit-user-flow-runner",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audit/user-flow/runner/src",
  "projectType": "library",
  "tags": ["type:domain", "scope:audit", "feature:audit-user-flow", "runtime:node", "layer:application"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/{projectRoot}",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "integration": {
      "dependsOn": ["test-orchestration:install-browser"],
      "command": "vitest run --config libs/audit/user-flow/runner/vitest.integration.config.mts"
    },
    "effect:diagnostics": {
      "options": {
        "args": ["--tsconfig", "{projectRoot}/tsconfig.lib.json"]
      }
    }
  }
}
