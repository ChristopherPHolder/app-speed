{
  "name": "audit-core-domain",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audit/core/domain/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:domain", "scope:audit", "feature:audit-core", "runtime:agnostic", "layer:model"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/audit/core/domain/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/audit/core/domain/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/audit/core/domain/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "effect:diagnostics": {
      "options": {
        "args": ["--tsconfig", "tsconfig.lib.json"]
      }
    }
  }
}
