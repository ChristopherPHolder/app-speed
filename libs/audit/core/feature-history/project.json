{
  "name": "audit-core-feature-history",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audit/core/feature-history/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:domain", "scope:audit", "feature:audit-core", "runtime:web", "layer:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": { "project": "{projectRoot}/ng-package.json", "tsConfig": "{projectRoot}/tsconfig.lib.json" },
      "defaultConfiguration": "production",
      "configurations": { "production": { "tsConfig": "{projectRoot}/tsconfig.lib.prod.json" }, "development": {} }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": { "configFile": "{projectRoot}/vitest.config.mts", "passWithNoTests": true }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
