{
  "name": "audit-core-portal-ui",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audit/core/portal-ui",
  "prefix": "b-ui",
  "projectType": "library",
  "tags": ["type:domain", "scope:audit", "feature:audit-core", "runtime:web", "layer:ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/audit/core/portal-ui/ng-package.json",
        "tsConfig": "libs/audit/core/portal-ui/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/audit/core/portal-ui/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
