{
  "name": "audit-core-api-contract",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audit/core/api-contract/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:domain", "scope:audit", "feature:audit-core", "runtime:agnostic", "layer:contract"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/audit/core/api-contract/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/audit/core/api-contract/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/audit/core/api-contract/tsconfig.lib.json"
        }
      }
    },
    "effect:diagnostics": {
      "options": {
        "args": ["--tsconfig", "tsconfig.lib.json"]
      }
    }
  }
}
