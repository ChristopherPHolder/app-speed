{
  "name": "convenience-trace-portal-data-access",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/convenience/trace/portal-data-access/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:domain", "scope:convenience", "feature:convenience-trace", "runtime:web", "layer:data-access"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/convenience/trace/portal-data-access/ng-package.json",
        "tsConfig": "libs/convenience/trace/portal-data-access/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/convenience/trace/portal-data-access/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "{projectRoot}/vitest.config.mts",
        "reportsDirectory": "{workspaceRoot}/coverage/libs/convenience/trace/portal-data-access"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
