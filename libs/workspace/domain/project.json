{
  "name": "workspace-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/workspace/domain/src",
  "projectType": "library",
  "tags": ["type:domain", "scope:shared", "runtime:agnostic"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "platform": "neutral",
        "outputPath": "dist/libs/workspace/domain",
        "format": ["esm"],
        "bundle": true,
        "main": "libs/workspace/domain/src/index.ts",
        "tsConfig": "libs/workspace/domain/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/workspace/domain/src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/workspace/domain/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/workspace/domain/vitest.config.mts"
      }
    }
  }
}
