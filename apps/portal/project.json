{
  "name": "portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/portal/src",
  "tags": [
    "type:app",
    "scope:portal",
    "runtime:web",
    "app:portal"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/portal/tsconfig.app.json"
      }
    },
    "build": {
      "executor": "@nx/angular:browser-esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "env": "CLERK_PUBLISHABLE_KEY"
        }
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/{projectRoot}",
        "index": "{projectRoot}/src/index.html",
        "main": "{projectRoot}/src/main.ts",
        "plugins": [
          "apps/portal/clerk-config.cjs"
        ],
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "assets": [
          "{projectRoot}/src/favicon.ico",
          "{projectRoot}/src/assets"
        ],
        "styles": [
          "{workspaceRoot}/libs/ui/theme/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "477kb",
              "maximumError": "600kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "7kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "e2e": {
          "main": "apps/portal/src/main.e2e.ts",
          "tsConfig": "apps/portal/tsconfig.e2e.json",
          "outputPath": "dist/apps/portal-e2e",
          "optimization": true,
          "outputHashing": "all",
          "index": "apps/portal-e2e/index.html",
          "styles": [
            "node_modules/@fontsource/roboto/300.css",
            "node_modules/@fontsource/roboto/400.css",
            "node_modules/@fontsource/roboto/500.css",
            "node_modules/@fontsource/material-icons/400.css",
            "apps/portal-e2e/fonts.css",
            "libs/ui/theme/styles.scss"
          ]
        }
      }
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "dependsOn": [
        "api:serve"
      ],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "proxyConfig": "apps/portal/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "portal:build:production"
        },
        "development": {
          "buildTarget": "portal:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "portal:build"
      }
    },
    "test": {},
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "portal:build"
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ]
    },
    "deploy": {
      "executor": "@app-speed/aws-deploy:s3-upload",
      "dependsOn": [
        "build"
      ],
      "defaultConfiguration": "development",
      "options": {
        "upload": "dist/{projectRoot}"
      },
      "configurations": {
        "production": {
          "bucket": "s3://appspeed.dev"
        },
        "development": {
          "bucket": "s3://dev.appspeed.dev"
        }
      }
    }
  }
}
