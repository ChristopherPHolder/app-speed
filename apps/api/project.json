{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["type:app", "scope:api", "runtime:node", "app:api"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/api/tsconfig.app.json"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "target": "node24",
        "outputPath": "dist/apps/api",
        "format": ["esm"],
        "bundle": true,
        "external": ["@aws-sdk/client-ec2", "@aws-sdk/client-s3", "@libsql/client"],
        "main": "apps/api/src/main.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": ["apps/api/src/assets"],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/api/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/api/patches",
        "{workspaceRoot}/dist/apps/api/local_path_modules"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "test": {},
    "integration": {
      "executor": "@app-speed/test-orchestration:local-system-test",
      "cache": false,
      "inputs": ["default", "^production", "{workspaceRoot}/tools/test-orchestration/**/*"],
      "options": {
        "suite": "integration",
        "testTarget": "api:integration-tests",
        "timeoutMs": 120000
      }
    },
    "integration-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/api"],
      "options": {
        "command": "vitest run --config vitest.config.integration.mts",
        "cwd": "apps/api"
      }
    },
    "effect:diagnostics": {
      "options": {
        "args": ["--tsconfig", "{projectRoot}/tsconfig.app.json"]
      }
    },
    "migrate": {
      "executor": "@app-speed/db-tools:drizzle-kit",
      "options": {
        "command": "migrate",
        "config": "apps/api/drizzle.config.ts"
      }
    },
    "migrate-generate": {
      "executor": "@app-speed/db-tools:drizzle-kit",
      "options": {
        "command": "generate",
        "config": "apps/api/drizzle.config.ts"
      }
    },
    "studio": {
      "executor": "@app-speed/db-tools:drizzle-kit",
      "options": {
        "command": "studio",
        "config": "apps/api/drizzle.config.ts"
      }
    },
    "deploy": {
      "executor": "@app-speed/aws-deploy:ssm-deploy",
      "defaultConfiguration": "development",
      "options": {
        "region": "eu-central-1",
        "documentName": "AWS-RunShellScript",
        "instanceIds": ["i-016827500a47a80ef"],
        "containerName": "app-speed-api",
        "hostPort": 3000,
        "containerPort": 3000,
        "pruneDockerBeforePull": true,
        "waitForCompletion": true,
        "pollIntervalMs": 5000,
        "timeoutMs": 900000
      },
      "configurations": {
        "development": {
          "additionalRunArgs": [
            "-e APP_ENV=development",
            "-e RUNNER_API_TOKEN",
            "-e SQLITE_PATH=/data/app-speed.sqlite",
            "-v app-speed-api-development:/data",
            "-e RUNNER_MANAGER_MODE=manual",
            "-e DATABASE_URL",
            "-e CLERK_SECRET_KEY",
            "-e CLERK_PUBLISHABLE_KEY",
            "-e CLERK_AUTHORIZED_PARTIES"
          ],
          "containerName": "app-speed-api-development",
          "hostPort": 3001,
          "pruneDockerBeforePull": false
        },
        "production": {
          "additionalRunArgs": [
            "-e APP_ENV=production",
            "-e MCP_RESOURCE_URL=https://appspeed.dev/mcp",
            "-e PORTAL_URL=https://appspeed.dev",
            "-e RUNNER_API_TOKEN",
            "-e RECORD_PERSISTENCE_MODE=s3",
            "-e RECORD_PERSISTENCE_BUCKET=app-speed-audit-results-prod",
            "-e AWS_REGION=eu-central-1",
            "-e DATABASE_URL",
            "-e CLERK_SECRET_KEY",
            "-e CLERK_PUBLISHABLE_KEY",
            "-e CLERK_AUTHORIZED_PARTIES"
          ]
        }
      },
      "dependsOn": ["auth-preflight"]
    },
    "build-e2e": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "platform": "node",
        "target": "node24",
        "outputPath": "dist/apps/api-e2e",
        "format": ["esm"],
        "bundle": true,
        "external": ["@aws-sdk/client-ec2", "@aws-sdk/client-s3", "@libsql/client"],
        "main": "apps/api/src/main.e2e.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": [],
        "generatePackageJson": false,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      }
    },
    "build-clerk-e2e": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "platform": "node",
        "target": "node24",
        "outputPath": "dist/apps/api-clerk-e2e",
        "format": ["esm"],
        "bundle": true,
        "external": ["@aws-sdk/client-ec2", "@aws-sdk/client-s3", "@libsql/client"],
        "main": "apps/api/src/main.clerk-e2e.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": [],
        "generatePackageJson": false,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      }
    },
    "auth-preflight": {
      "executor": "@app-speed/aws-deploy:auth-preflight",
      "cache": false,
      "defaultConfiguration": "development",
      "options": {
        "application": "api"
      },
      "configurations": {
        "production": {
          "environment": "production",
          "portalOrigin": "https://appspeed.dev"
        },
        "development": {
          "environment": "development",
          "portalOrigin": "https://dev.appspeed.dev"
        }
      }
    }
  }
}
