{
  "name": "portal-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal-e2e",
  "tags": ["e2e"],
  "implicitDependencies": ["portal", "api", "runner"],
  "targets": {
    "e2e": {
      "executor": "@app-speed/test-orchestration:local-system-test",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/portal-e2e/fixture/**/*",
        "{workspaceRoot}/apps/api/**/*",
        "{workspaceRoot}/apps/runner/**/*",
        "{workspaceRoot}/tools/test-orchestration/**/*"
      ],
      "options": {
        "suite": "e2e",
        "testTarget": "portal-e2e:cypress",
        "timeoutMs": 600000
      },
      "configurations": {
        "update-snapshots": {
          "updateSnapshots": true
        }
      }
    },
    "cypress": {
      "cache": false,
      "options": {
        "config-file": "./cypress.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/portal-e2e/tsconfig.json"
      }
    },
    "e2e-clerk": {
      "executor": "@app-speed/test-orchestration:local-system-test",
      "cache": false,
      "options": {
        "suite": "e2e",
        "clerk": true,
        "testTarget": "portal-e2e:cypress-clerk",
        "timeoutMs": 300000
      }
    },
    "cypress-clerk": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cypress run --config-file=cypress.clerk.config.ts",
        "cwd": "apps/portal-e2e"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/portal-e2e/vitest.config.mts"
      }
    },
    "install-cypress": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cypress install"
      }
    }
  }
}
