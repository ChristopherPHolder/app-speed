{
  "name": "portal-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal-e2e",
  "tags": ["e2e"],
  "implicitDependencies": ["portal", "api", "runner"],
  "targets": {
    "e2e": {
      "executor": "@app-speed/test-orchestration:local-system-test",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/portal-e2e/fixture/**/*",
        "{workspaceRoot}/apps/api/**/*",
        "{workspaceRoot}/apps/runner/**/*",
        "{workspaceRoot}/tools/test-orchestration/**/*"
      ],
      "options": {
        "suite": "e2e",
        "testTarget": "portal-e2e:cypress",
        "timeoutMs": 300000
      }
    },
    "cypress": {
      "executor": "@nx/cypress:cypress",
      "cache": false,
      "options": {
        "cypressConfig": "apps/portal-e2e/cypress.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/portal-e2e/tsconfig.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
